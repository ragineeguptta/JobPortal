@model List<JobPortal.UI.ViewModels.Job.JobListViewModel>

<h2>Job Listings</h2>

<div class="row">
    @foreach (var job in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card p-3">
                <h5>@job.Title</h5>
                <p>@job.Company</p>
                <p>@job.Location</p>

                <a class="btn btn-custom">Apply Now</a>
            </div>
        </div>
    }
</div>