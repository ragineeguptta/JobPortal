@model JobPortal.UI.ViewModels.Auth.RegisterViewModel

<div class="login-container">
    <div class="login-card">
        <h2>Welcome Back 👋</h2>
        <p class="subtitle">Register to your account</p>

        <form method="post">
            <div class="form-group">
                <label>Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter your name" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Enter password" />
            </div>

            <button type="submit" class="btn-login">Register</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

    </div>
</div>