@model JobPortal.UI.ViewModels.Auth.LoginViewModel

<h2>Login</h2>

<form method="post">
    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password</label>
        <input asp-for="PasswordHash" type="password" />
    </div>

    <button type="submit">Login</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}